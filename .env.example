# ============================================================
# BARI - Bengaluru AI Road Intelligence — Configuration
# Copy this file to .env and adjust values as needed.
# ============================================================

# --- Model ---
MODEL_PATH=ml/training/runs/pothole_yolo/weights/best.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
DEVICE=auto
# imgsz used for both inference and export
IMG_SIZE=640

# --- Tracking / Event confirmation ---
TRACKER=bytetrack.yaml
MIN_TRACK_FRAMES=3

# --- Duplicate detection ---
DUPLICATE_DISTANCE_METERS=8
DUPLICATE_TIME_WINDOW_HOURS=720

# --- GPS synchronization ---
GPS_INTERPOLATION=true
GPS_MAX_GAP_SECONDS=5
GPS_TIME_OFFSET_SECONDS=0
GPS_MIN_ACCURACY_METERS=50

# --- Severity heuristic weights (must be tunable, not hard fixed logic) ---
SEVERITY_AREA_LOW=0.015
SEVERITY_AREA_HIGH=0.05

# --- Geocoding ---
GEOCODER_PROVIDER=nominatim
GEOCODER_USER_AGENT=bari-pothole-detector/1.0 (contact: example@example.com)
GEOCODER_TIMEOUT_SECONDS=10
GEOCODER_MIN_INTERVAL_SECONDS=1.0
GEOCODER_MAX_RETRIES=3

# --- Bengaluru GIS boundary files (see data/bengaluru/README.md) ---
ZONE_BOUNDARY_GEOJSON=data/bengaluru/zones.geojson
WARD_BOUNDARY_GEOJSON=data/bengaluru/wards.geojson

# --- Storage ---
DATABASE_PATH=data/bari.db
EVIDENCE_PATH=data/evidence
OUTPUT_PATH=data/output

# --- Timezone ---
TIMEZONE=Asia/Kolkata

# --- Dashboard ---
# 127.0.0.1 = this machine only. Set to 0.0.0.0 to allow other devices on your
# WiFi (e.g. a phone running dashboard/static/mobile.html) to reach it.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8000
